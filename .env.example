# 复制为 .env 后修改。所有项都可选。

# 登录密码。不设置时, 首次启动自动生成一个并打印在日志里(之后沿用 data/auth.json)
APP_PASSWORD=

# 1 = 允许不登录也能查看持仓(只读)。默认 0, 查看和修改都要登录。放在公网时请保持 0
PUBLIC_READ=0

# 1 = 首次启动时载入虚构的演示持仓, 方便先看效果
DEMO=0

# 服务端口
PORT=3457

# 前面有反向代理(Nginx/Caddy)时设为 1, 才能拿到真实客户端 IP 做限流
TRUST_PROXY=0

# ---- 可选: 券商自动同步(都是只读) ----
# 每家的配置步骤见 docs/brokers/ 下的说明; 不填就不启用。没有接口的券商可以在电脑版用「导入 CSV」

# ---- Interactive Brokers(Flex Web Service, 见 docs/brokers/ib.md) ----
IB_FLEX_TOKEN=
IB_FLEX_POSITIONS_QUERY=
IB_FLEX_CONFIRMS_QUERY=
# 看板里对应 IB 的账户名(默认 IB)
IB_SYNC_ACCOUNT=IB
# 令牌到期日 YYYY-MM-DD, 到期前 30 天在页面提醒
IB_FLEX_TOKEN_EXPIRES=
# 1 = 试运行: 只记录会改什么, 不真正写持仓
IB_SYNC_DRYRUN=0
# 看板某只股票另有 IB 之外的股数时(比如在别的平台也持有), 填 "代码:股数:成本", 多个用逗号分隔, 如 AAPL:3:160
# 对账时会按 IB 股数 + 这部分来算; 之后可在手机端该持仓的修改弹窗里一次性处理
IB_SYNC_EXTRA=

# ---- 长桥 Longbridge(官方 OpenAPI, 见 docs/brokers/longbridge.md; 需要先 npm install longport) ----
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# Access Token 到期日 YYYY-MM-DD, 到期前 30 天在页面提醒
LONGBRIDGE_TOKEN_EXPIRES=
# 看板里对应的账户名(默认 长桥); 港股 / A 股想放进别的账户(比如 HKD 账户)时分别填
LONGBRIDGE_SYNC_ACCOUNT=长桥
LONGBRIDGE_ACCOUNT_US=
LONGBRIDGE_ACCOUNT_HK=
LONGBRIDGE_ACCOUNT_CN=
LONGBRIDGE_SYNC_DRYRUN=0

# ---- 自己写的券商适配器(见 docs/brokers/custom.md) ----
# 逗号分隔的文件路径; 相对路径按项目目录算, Docker 里建议放到数据目录用绝对路径, 如 /data/brokers/my-broker.js
BROKER_ADAPTERS=

# ---- 可选: 备份导出接口 ----
# 设置后可用 GET /api/internal/history-export(请求头 X-Backup-Token)导出完整历史, 方便自己写备份脚本
BACKUP_TOKEN=
